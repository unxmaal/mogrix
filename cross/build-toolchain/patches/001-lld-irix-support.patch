+  // extensions and requires a 2-segment (RE + RW) layout.
+  if (ctx.arg.osabi == ELFOSABI_IRIX) {
+    ctx.arg.singleRoRx = true;
+    ctx.arg.zRelro = false;
+    ctx.arg.zText = false;
