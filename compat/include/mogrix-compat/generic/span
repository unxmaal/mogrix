/* mogrix compat: <span> polyfill for GCC 9 libstdc++
 *
 * GCC 9 libstdc++ doesn't provide <span> (C++20). Clang 16 with -std=c++20
 * defines __cplusplus=202002L, so code like WebKitGTK unconditionally includes
 * <span>. This provides a conforming std::span implementation using only
 * C++17 language features (which clang 16 fully supports).
 *
 * Based on the tcb::span reference implementation (BSL-1.0).
 * Covers: span<T>, span<T,N>, dynamic_extent, .data(), .size(), .begin(),
 * .end(), .front(), .back(), .empty(), operator[], .subspan(), .first(),
 * .last(), as_bytes(), as_writable_bytes().
 */
#ifndef MOGRIX_SPAN_POLYFILL_H
#define MOGRIX_SPAN_POLYFILL_H

#include <array>
#include <cstddef>
#include <iterator>
#include <limits>
#include <type_traits>

namespace std {

inline constexpr size_t dynamic_extent = static_cast<size_t>(-1);

template <typename T, size_t Extent = dynamic_extent>
class span;

namespace detail {

template <typename T>
struct is_span_impl : false_type {};

template <typename T, size_t S>
struct is_span_impl<span<T, S>> : true_type {};

template <typename T>
using is_span = is_span_impl<remove_cv_t<T>>;

template <typename T>
struct is_std_array_impl : false_type {};

template <typename T, size_t N>
struct is_std_array_impl<array<T, N>> : true_type {};

template <typename T>
using is_std_array = is_std_array_impl<remove_cv_t<T>>;

template <typename, typename = void>
struct has_size_and_data : false_type {};

template <typename T>
struct has_size_and_data<T, void_t<
    decltype(std::size(declval<T>())),
    decltype(std::data(declval<T>()))
>> : true_type {};

template <typename C, typename ElementType, typename = void>
struct is_compatible_container : false_type {};

template <typename C, typename ElementType>
struct is_compatible_container<C, ElementType, void_t<
    enable_if_t<!is_span<C>::value>,
    enable_if_t<!is_std_array<C>::value>,
    enable_if_t<!is_array<C>::value>,
    enable_if_t<has_size_and_data<C>::value>,
    enable_if_t<is_convertible<remove_pointer_t<decltype(data(declval<C&>()))>(*)[], ElementType(*)[]>::value>
>> : true_type {};

} // namespace detail

template <typename T, size_t Extent>
class span {
public:
    using element_type = T;
    using value_type = remove_cv_t<T>;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using const_pointer = const T*;
    using reference = T&;
    using const_reference = const T&;
    using iterator = pointer;
    using reverse_iterator = std::reverse_iterator<iterator>;

    static constexpr size_type extent = Extent;

    /* Constructors for fixed-extent span */
    template <size_t E = Extent, enable_if_t<E == 0, int> = 0>
    constexpr span() noexcept : data_(nullptr) {}

    constexpr span(pointer ptr, size_type /*count*/) noexcept : data_(ptr) {}

    constexpr span(pointer first, pointer /*last*/) noexcept : data_(first) {}

    template <size_t N, enable_if_t<N == Extent, int> = 0>
    constexpr span(element_type (&arr)[N]) noexcept : data_(arr) {}

    template <typename U, size_t N,
              enable_if_t<N == Extent && is_convertible<U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(array<U, N>& arr) noexcept : data_(arr.data()) {}

    template <typename U, size_t N,
              enable_if_t<N == Extent && is_convertible<const U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(const array<U, N>& arr) noexcept : data_(arr.data()) {}

    template <typename Container,
              enable_if_t<detail::is_compatible_container<Container, element_type>::value, int> = 0>
    constexpr span(Container& c) : data_(std::data(c)) {}

    template <typename Container,
              enable_if_t<detail::is_compatible_container<const Container, element_type>::value, int> = 0>
    constexpr span(const Container& c) : data_(std::data(c)) {}

    template <typename U, size_t N,
              enable_if_t<N == Extent && is_convertible<U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(const span<U, N>& other) noexcept : data_(other.data()) {}

    template <typename U,
              enable_if_t<is_convertible<U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(const span<U, dynamic_extent>& other) noexcept : data_(other.data()) {}

    constexpr span(const span&) noexcept = default;
    constexpr span& operator=(const span&) noexcept = default;

    constexpr pointer data() const noexcept { return data_; }
    constexpr size_type size() const noexcept { return Extent; }
    constexpr size_type size_bytes() const noexcept { return Extent * sizeof(T); }
    constexpr bool empty() const noexcept { return Extent == 0; }

    constexpr reference operator[](size_type idx) const { return data_[idx]; }
    constexpr reference front() const { return data_[0]; }
    constexpr reference back() const { return data_[Extent - 1]; }

    constexpr iterator begin() const noexcept { return data_; }
    constexpr iterator end() const noexcept { return data_ + Extent; }
    constexpr reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
    constexpr reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }

    template <size_t Count>
    constexpr span<T, Count> first() const {
        return span<T, Count>(data_, Count);
    }
    constexpr span<T, dynamic_extent> first(size_type count) const {
        return {data_, count};
    }

    template <size_t Count>
    constexpr span<T, Count> last() const {
        return span<T, Count>(data_ + (Extent - Count), Count);
    }
    constexpr span<T, dynamic_extent> last(size_type count) const {
        return {data_ + (Extent - count), count};
    }

    template <size_t Offset, size_t Count = dynamic_extent>
    constexpr auto subspan() const {
        constexpr size_t E = (Count != dynamic_extent) ? Count : (Extent - Offset);
        return span<T, E>(data_ + Offset, E);
    }
    constexpr span<T, dynamic_extent> subspan(size_type offset, size_type count = dynamic_extent) const {
        return {data_ + offset, count == dynamic_extent ? Extent - offset : count};
    }

private:
    pointer data_;
};

/* Dynamic-extent specialization */
template <typename T>
class span<T, dynamic_extent> {
public:
    using element_type = T;
    using value_type = remove_cv_t<T>;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using const_pointer = const T*;
    using reference = T&;
    using const_reference = const T&;
    using iterator = pointer;
    using reverse_iterator = std::reverse_iterator<iterator>;

    static constexpr size_type extent = dynamic_extent;

    constexpr span() noexcept : data_(nullptr), size_(0) {}

    constexpr span(pointer ptr, size_type count) noexcept : data_(ptr), size_(count) {}

    constexpr span(pointer first, pointer last) noexcept : data_(first), size_(static_cast<size_type>(last - first)) {}

    template <size_t N>
    constexpr span(element_type (&arr)[N]) noexcept : data_(arr), size_(N) {}

    template <typename U, size_t N,
              enable_if_t<is_convertible<U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(array<U, N>& arr) noexcept : data_(arr.data()), size_(N) {}

    template <typename U, size_t N,
              enable_if_t<is_convertible<const U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(const array<U, N>& arr) noexcept : data_(arr.data()), size_(N) {}

    template <typename Container,
              enable_if_t<detail::is_compatible_container<Container, element_type>::value, int> = 0>
    constexpr span(Container& c) : data_(std::data(c)), size_(std::size(c)) {}

    template <typename Container,
              enable_if_t<detail::is_compatible_container<const Container, element_type>::value, int> = 0>
    constexpr span(const Container& c) : data_(std::data(c)), size_(std::size(c)) {}

    template <typename U, size_t N,
              enable_if_t<is_convertible<U(*)[], T(*)[]>::value, int> = 0>
    constexpr span(const span<U, N>& other) noexcept : data_(other.data()), size_(other.size()) {}

    constexpr span(const span&) noexcept = default;
    constexpr span& operator=(const span&) noexcept = default;

    constexpr pointer data() const noexcept { return data_; }
    constexpr size_type size() const noexcept { return size_; }
    constexpr size_type size_bytes() const noexcept { return size_ * sizeof(T); }
    constexpr bool empty() const noexcept { return size_ == 0; }

    constexpr reference operator[](size_type idx) const { return data_[idx]; }
    constexpr reference front() const { return data_[0]; }
    constexpr reference back() const { return data_[size_ - 1]; }

    constexpr iterator begin() const noexcept { return data_; }
    constexpr iterator end() const noexcept { return data_ + size_; }
    constexpr reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
    constexpr reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }

    template <size_t Count>
    constexpr span<T, Count> first() const {
        return span<T, Count>(data_, Count);
    }
    constexpr span<T, dynamic_extent> first(size_type count) const {
        return {data_, count};
    }

    template <size_t Count>
    constexpr span<T, Count> last() const {
        return span<T, Count>(data_ + (size_ - Count), Count);
    }
    constexpr span<T, dynamic_extent> last(size_type count) const {
        return {data_ + (size_ - count), count};
    }

    template <size_t Offset, size_t Count = dynamic_extent>
    constexpr auto subspan() const {
        return span<T, Count>(data_ + Offset, Count == dynamic_extent ? size_ - Offset : Count);
    }
    constexpr span<T, dynamic_extent> subspan(size_type offset, size_type count = dynamic_extent) const {
        return {data_ + offset, count == dynamic_extent ? size_ - offset : count};
    }

private:
    pointer data_;
    size_type size_;
};

/* Deduction guides */
template <typename T, size_t N>
span(T (&)[N]) -> span<T, N>;

template <typename T, size_t N>
span(array<T, N>&) -> span<T, N>;

template <typename T, size_t N>
span(const array<T, N>&) -> span<const T, N>;

template <typename Container>
span(Container&) -> span<typename remove_pointer<decltype(data(declval<Container&>()))>::type>;

template <typename Container>
span(const Container&) -> span<const typename remove_pointer<decltype(data(declval<const Container&>()))>::type>;

/* as_bytes / as_writable_bytes */
template <typename T, size_t N>
auto as_bytes(span<T, N> s) noexcept
    -> span<const byte, N == dynamic_extent ? dynamic_extent : N * sizeof(T)>
{
    return {reinterpret_cast<const byte*>(s.data()), s.size_bytes()};
}

template <typename T, size_t N, enable_if_t<!is_const<T>::value, int> = 0>
auto as_writable_bytes(span<T, N> s) noexcept
    -> span<byte, N == dynamic_extent ? dynamic_extent : N * sizeof(T)>
{
    return {reinterpret_cast<byte*>(s.data()), s.size_bytes()};
}

} // namespace std

#endif /* MOGRIX_SPAN_POLYFILL_H */
