#!/bin/sh
#
# IRIX C++ cross-compiler wrapper using clang++ + LLVM libc++
#
# This wrapper handles:
# - Preprocess only (-E): uses clang++ directly
# - Compile only (-c): uses clang++ directly
# - Link only (.o files, no source): uses LLD linker wrapper
# - Compile+link (has source and no -c): compiles with clang++, links with LLD
#
# Key differences from irix-cxx (libstdc++ version):
# - Uses LLVM libc++ headers instead of GCC 9 libstdc++
# - Links -lc++ -lc++abi instead of -lstdc++
# - Uses libgcc_s for unwinding (NOT LLVM libunwind — broken on MIPS N32)
# - C++ exceptions WORK (throw/catch, rethrow, RTTI, destructor unwind)
# - Adds IRIX-specific compat header for restrict/timespec fixes
#
# Deployed by: mogrix setup-cross
#

# Configurable paths - set by mogrix setup-cross
SYSROOT="${IRIX_SYSROOT:-/opt/irix-sysroot}"
STAGING="${SGUG_STAGING:-/opt/sgug-staging/usr/sgug}"
CLANG="${IRIX_CLANG:-/opt/cross/bin/clang++}"
LD="${STAGING}/bin/irix-ld"

# LLVM project source paths for libc++ headers
LLVM_PROJECT="${LLVM_PROJECT:-$HOME/projects/github/llvm-project}"
LIBCXX_CONFIG="${LIBCXX_CONFIG:-$(dirname "$0")/../build-runtime/libcxx-config}"

# Header search order:
# 1. libc++ __config_site (IRIX-specific configuration)
# 2. LLVM libc++ headers (C++ standard library)
# 3. LLVM libc++abi headers (low-level C++ ABI)
# 4. IRIX C++ compat header (restrict/timespec fixes)
# 5. SGUG mogrix compat headers (fix IRIX headers for cross-build)
# 6. SGUG clang compat headers (fix IRIX headers for clang)
# 7. SGUG staging headers (cross-built packages)
# 8. IRIX sysroot headers (pristine IRIX)
# -mxgot: 32-bit GOT offsets. Without this, LLD creates secondary GOTs for
# large libraries that IRIX rld cannot displace, causing SIGSEGV.
CLANG_FLAGS="--target=mips-sgi-irix6.5 -mabi=n32 -march=mips3 -mxgot"
# Override _MIPS_ISA - clang sets _MIPS_ISA_MIPS64 which IRIX headers don't recognize
# (same fix as irix-cc)
CLANG_FLAGS="$CLANG_FLAGS -U_MIPS_ISA -D_MIPS_ISA=_MIPS_ISA_MIPS3"
# Disable default C/C++ header search — we provide explicit -isystem paths
CLANG_FLAGS="$CLANG_FLAGS -nostdlibinc -nostdinc++"
# Force-include order is CRITICAL:
# 1. sgidefs.h — provides __int64_t etc. for sys/types.h
# 2. stdarg.h — defines va_list correctly for IRIX
SCRIPT_DIR="$(dirname "$0")"
# Fix IRIX __restrict→restrict for C++ mode. Must be FIRST include.
# Pulls in sgimacros.h then redefines __restrict to __restrict__ (clang C++ qualifier).
CLANG_FLAGS="$CLANG_FLAGS -include $SCRIPT_DIR/irix-cxx-restrict-fix.h"
CLANG_FLAGS="$CLANG_FLAGS -include $SYSROOT/usr/include/sgidefs.h"
CLANG_FLAGS="$CLANG_FLAGS -include $STAGING/include/dicl-clang-compat/stdarg.h"
# NOTE: utility_polyfill.h NOT force-included for libc++ — it's only needed for
# libstdc++ (broken to_string, missing cmp_*). libc++ has native implementations.
# C++20 polyfill overrides (ranges, semaphore, source_location) — must be
# searched BEFORE libc++ headers so our polyfills intercept #include <ranges> etc.
# These polyfills use #include_next to chain to libc++'s own <ranges> if available.
CLANG_FLAGS="$CLANG_FLAGS -I$STAGING/include/mogrix-cxx20-polyfills"
# libc++ headers: __config_site from mogrix config, headers from LLVM source
CLANG_FLAGS="$CLANG_FLAGS -I$STAGING/include/mogrix-libcxx-config"
CLANG_FLAGS="$CLANG_FLAGS -I$LLVM_PROJECT/libcxx/include"
CLANG_FLAGS="$CLANG_FLAGS -I$LLVM_PROJECT/libcxxabi/include"
# System compat headers (xlocale stubs, math fixes, etc.)
CLANG_FLAGS="$CLANG_FLAGS -isystem $STAGING/include/mogrix-compat"
CLANG_FLAGS="$CLANG_FLAGS -isystem $STAGING/include/mogrix-compat/generic"
CLANG_FLAGS="$CLANG_FLAGS -isystem $STAGING/include/dicl-clang-compat"
CLANG_FLAGS="$CLANG_FLAGS -isystem $STAGING/include"
CLANG_FLAGS="$CLANG_FLAGS -isystem $SYSROOT/usr/include"
CLANG_FLAGS="$CLANG_FLAGS -D_SGI_SOURCE -D_SGI_MP_SOURCE -D_SGI_REENTRANT_FUNCTIONS"
# IRIX is Unix — packages check __unix__ for Unix-specific code paths
CLANG_FLAGS="$CLANG_FLAGS -Dunix=1 -D__unix__=1 -D__unix=1"
CLANG_FLAGS="$CLANG_FLAGS -D__ELF__ -D__sgi=1 -D__c99"
CLANG_FLAGS="$CLANG_FLAGS -D_LANGUAGE_C_PLUS_PLUS=1 -D_LONGLONG=1"
# IRIX bool/wchar_t type support flags
CLANG_FLAGS="$CLANG_FLAGS -D_BOOL -D_WCHAR_T_IS_KEYWORD"
# Prevent IRIX headers from typedef-ing wchar_t (it's a C++ keyword)
CLANG_FLAGS="$CLANG_FLAGS -D_WCHAR_T"
# libc++ locale/filesystem support
CLANG_FLAGS="$CLANG_FLAGS -D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE"
CLANG_FLAGS="$CLANG_FLAGS -D_LIBCPP_WCHAR_H_HAS_CONST_OVERLOADS=1"
CLANG_FLAGS="$CLANG_FLAGS -D_LIBCPP_CONSTINIT="
CLANG_FLAGS="$CLANG_FLAGS -DELAST=1700"
# IRIX C++ namespace macros
CLANG_FLAGS="$CLANG_FLAGS -D__SGI_LIBC_NAMESPACE_QUALIFIER="
CLANG_FLAGS="$CLANG_FLAGS -D__SGI_LIBC_BEGIN_NAMESPACE_STD="
CLANG_FLAGS="$CLANG_FLAGS -D__SGI_LIBC_END_NAMESPACE_STD="
CLANG_FLAGS="$CLANG_FLAGS -D__SGI_LIBC_USING_FROM_STD(x)="
# IRIX libc doesn't have __cxa_atexit (Itanium C++ ABI) — use atexit() instead
CLANG_FLAGS="$CLANG_FLAGS -fno-use-cxa-atexit"
# Use .ctors/.dtors instead of .init_array/.fini_array — IRIX rld doesn't support init_array
CLANG_FLAGS="$CLANG_FLAGS -fno-use-init-array"

# Handle --version and -v (compiler identification for build systems like meson)
for arg in "$@"; do
    case "$arg" in
        --version|-v|-V|--help|-dumpversion|-dumpmachine|-print-search-dirs|-print-*)
            exec $CLANG $CLANG_FLAGS "$@"
            ;;
    esac
done

# Check if this is preprocess-only (-E flag present) or dependency-only (-M, -MM)
preprocess_only=false
if echo " $* " | grep -q " -E "; then
    preprocess_only=true
fi
if echo " $* " | grep -qE " -M | -MM "; then
    preprocess_only=true
fi

# Check if this is compile-only (-c flag present)
compile_only=false
if echo " $* " | grep -q " -c "; then
    compile_only=true
fi

# Check if there are any C++ or C source files in the arguments
has_source=false
for arg in "$@"; do
    case "$arg" in
        *.cpp|*.cxx|*.cc|*.C|*.c|*.S|*.s)
            has_source=true
            break
            ;;
    esac
done

# Check if this is just linking (.o files only)
link_only=false
if [ "$has_source" = "false" ]; then
    link_only=true
fi

if [ "$preprocess_only" = "true" ]; then
    # Preprocess only - use clang++ directly
    exec $CLANG $CLANG_FLAGS "$@"
elif [ "$compile_only" = "true" ]; then
    # Compile only - use clang++ directly
    exec $CLANG $CLANG_FLAGS "$@"
elif [ "$link_only" = "true" ]; then
    # Link only - filter out compile-only flags and pass to LLD wrapper
    link_args=""
    next_is_output=false
    for arg in "$@"; do
        if [ "$next_is_output" = "true" ]; then
            link_args="$link_args -o $arg"
            next_is_output=false
            continue
        fi
        case "$arg" in
            -o)
                next_is_output=true
                ;;
            # Translate -Wl,xxx,yyy to xxx yyy (linker passthrough flags)
            -Wl,*)
                ld_flag=$(echo "$arg" | sed 's/^-Wl,//' | tr ',' ' ')
                link_args="$link_args $ld_flag"
                ;;
            # Skip compile-only flags (but not -Wl which is handled above)
            -D*|-I*|-W*|-O*|-g|-g[0-9]|-std=*|-c|-Q*|-f*|-m*)
                ;;
            # Skip compiler flags that LLD doesn't understand
            -static|-dynamic|-Bdynamic|-Bstatic|-pedantic|-pedantic-errors)
                ;;
            -pipe|-pthread|-traditional|-ansi|-w)
                ;;
            *)
                link_args="$link_args $arg"
                ;;
        esac
    done
    # Add C++ standard library for linking
    exec $LD $link_args -lc++ -lc++abi -lgcc_s
else
    # Compile + link in one step
    # We need to compile sources to objects, then link

    # Collect source files, output file, and other args
    sources=""
    objects=""
    output=""
    other_args=""
    libs=""
    next_is_output=false

    link_args=""
    for arg in "$@"; do
        if [ "$next_is_output" = "true" ]; then
            output="$arg"
            next_is_output=false
            continue
        fi
        case "$arg" in
            -o)
                next_is_output=true
                ;;
            *.cpp|*.cxx|*.cc|*.C|*.c|*.S|*.s)
                sources="$sources $arg"
                ;;
            *.o|*.a)
                objects="$objects $arg"
                ;;
            *.so|*.so.*)
                # Direct shared library references
                libs="$libs $arg"
                ;;
            -l*|-L*)
                libs="$libs $arg"
                ;;
            # Translate -Wl,xxx,yyy to xxx yyy for linker
            -Wl,*)
                ld_flag=$(echo "$arg" | sed 's/^-Wl,//' | tr ',' ' ')
                link_args="$link_args $ld_flag"
                ;;
            -D*|-I*|-W*|-O*|-g*|-f*|-m*|-std=*|-Q*)
                other_args="$other_args $arg"
                ;;
            # Skip link-only flags during compile phase
            -static|-dynamic|-Bdynamic|-Bstatic)
                ;;
            -shared)
                # Pass -shared to the linker
                link_args="$link_args -shared"
                ;;
            *)
                # Pass through other args
                other_args="$other_args $arg"
                ;;
        esac
    done

    # Default output name
    if [ -z "$output" ]; then
        output="a.out"
    fi

    # Compile sources to temp objects
    tmpdir=$(mktemp -d)
    trap "rm -rf $tmpdir" EXIT

    compiled_objs=""
    for src in $sources; do
        base=$(basename "$src" | sed 's/\.[cCsS].*$//')
        obj="$tmpdir/${base}.o"
        $CLANG $CLANG_FLAGS $other_args -c -o "$obj" "$src" || exit $?
        compiled_objs="$compiled_objs $obj"
    done

    # Link everything — add C++ standard library
    exec $LD $link_args -o "$output" $compiled_objs $objects $libs -lc++ -lc++abi -lgcc_s
fi
