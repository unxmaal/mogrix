/* mogrix compat: <bit> polyfill for GCC 9 libstdc++
 * Provides std::popcount, std::countl_zero, std::countr_zero, etc.
 */
#ifndef MOGRIX_BIT_POLYFILL_H
#define MOGRIX_BIT_POLYFILL_H

#include <type_traits>
#include <cstdint>
#include <climits>

namespace std {

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, int>
popcount(T x) noexcept {
    int count = 0;
    while (x) {
        count += (x & 1);
        x >>= 1;
    }
    return count;
}

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, int>
countl_zero(T x) noexcept {
    if (x == 0)
        return sizeof(T) * CHAR_BIT;
    int n = 0;
    T msb = static_cast<T>(static_cast<T>(1) << (sizeof(T) * CHAR_BIT - 1));
    while (!(x & msb)) {
        ++n;
        x <<= 1;
    }
    return n;
}

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, int>
countr_zero(T x) noexcept {
    if (x == 0)
        return sizeof(T) * CHAR_BIT;
    int n = 0;
    while (!(x & 1)) {
        ++n;
        x >>= 1;
    }
    return n;
}

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, bool>
has_single_bit(T x) noexcept {
    return x != 0 && (x & (x - 1)) == 0;
}

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, T>
bit_ceil(T x) noexcept {
    if (x <= 1) return 1;
    return static_cast<T>(static_cast<T>(1) << (sizeof(T) * CHAR_BIT - countl_zero(static_cast<T>(x - 1))));
}

template <typename T>
constexpr enable_if_t<is_unsigned<T>::value, T>
bit_floor(T x) noexcept {
    if (x == 0) return 0;
    return static_cast<T>(static_cast<T>(1) << (sizeof(T) * CHAR_BIT - 1 - countl_zero(x)));
}

} // namespace std

#endif /* MOGRIX_BIT_POLYFILL_H */
